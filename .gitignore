!data/questionnaire/.gitkeep
!data/processed/.gitkeep

# Модели
models_storage/*.pkl

# Логи
logs/
*.log

# Временные файлы
.DS_Store
Thumbs.db

# Тестовые скрипты
collect_test.py

# PyInstaller
build/
dist/
*.spec

# CSV-файлы (данные, метрики, отчёты)
*.csv

# Архивы (датасеты Kaggle)
*.zip

# Markdown-файлы, кроме README
*.md
!README.md

# Отчёты обучения
output/*.txt
