# ============================================
# Параметры трекера (переопределяются через .env)
# ============================================

# Интервал сбора метрик (в секундах)
COLLECTION_INTERVAL=60

# Сколько дней собирать данные
DAYS_TO_COLLECT=21

# Имя пользователя (ФИО) — используется при объединении с анкетами
# USER_NAME=Иванов Иван Иванович

# ============================================
# Параметры анкеты и обучения (переопределяются через .env)
# ============================================

# CSV с ответами Google Forms (имя файла внутри data/questionnaire/)
# QUESTIONNAIRE_FILE=answers.csv

# Обучающий датасет (имя файла внутри data/)
# TRAIN_DATA_FILE=developer_burnout_7000.zip

# TEST_SIZE=0.2
# RANDOM_STATE=42

# Имя файла модели (внутри models_storage/)
# MODEL_FILE=burnout_model.pkl

# ============================================
# Параметры расчёта дневных признаков (features)
# ============================================

# Файл дневных признаков (внутри data/)
# FEATURES_FILE=features.csv

# Границы рабочего дня (ЧЧ:ММ)
# WORK_DAY_START=08:30
# WORK_DAY_END=17:30

# Минимум занятых минут вне графика, чтобы засчитать работу вне рабочего дня
# AFTER_HOURS_MIN_MINUTES=10

# Перерыв: простой от MIN до MAX минут внутри рабочего дня
# BREAK_MIN_MINUTES=5
# BREAK_MAX_MINUTES=60

# Встреча: звонок не короче MIN минут, разрывы меньше MERGE_GAP склеиваются
# MEETING_MIN_MINUTES=5
# MEETING_MERGE_GAP_MINUTES=5

# Максимальная длина ночного простоя, который считается сном (часы)
# SLEEP_MAX_HOURS=12

# Сон по умолчанию, если ночной простой измерить нельзя (часы)
# SLEEP_DEFAULT_HOURS=7

# ============================================
# Параметры объединения данных (merge)
# ============================================

# Файл с метриками трекера (внутри raw_data/)
# TRACKER_FILE=metrics.csv

# Итоговый объединённый датасет (внутри data/)
# MERGED_FILE=merged_data.csv

# За сколько последних дней данных усредняются признаки (0 — за весь период)
# MERGE_WINDOW_DAYS=14
